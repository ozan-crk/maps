generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model MapProject {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  layers      Layer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Layer {
  id        String       @id @default(cuid())
  maps      MapProject[]
  name      String
  iconUrl   String?      @db.Text
  color     String?     // Poligonlar veya marker ikonları için renk
  isActive  Boolean      @default(true)
  features  Feature[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model Feature {
  id          String   @id @default(cuid())
  layerId     String
  layer       Layer    @relation(fields: [layerId], references: [id], onDelete: Cascade)
  title       String   @db.Text
  description String?  @db.Text
  iconUrl     String?  @db.Text
  type        String   // "POINT", "POLYGON", "LINESTRING" vs.
  coordinates String   @db.LongText // JSON string olarak koordinatlar: "[lng, lat]" veya "[[[lng,lat], ...]]"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
