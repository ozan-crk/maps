generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model MapProject {
  id          String   @id @default(cuid())
  name        String
  description String?
  layers      Layer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Layer {
  id        String      @id @default(cuid())
  mapId     String
  map       MapProject @relation(fields: [mapId], references: [id], onDelete: Cascade)
  name      String
  iconUrl   String?
  color     String?     // Poligonlar veya marker ikonları için renk
  isActive  Boolean     @default(true)
  features  Feature[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model Feature {
  id          String   @id @default(cuid())
  layerId     String
  layer       Layer    @relation(fields: [layerId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  iconUrl     String?
  type        String   // "POINT", "POLYGON", "LINESTRING" vs.
  coordinates String   @db.LongText // JSON string olarak koordinatlar: "[lng, lat]" veya "[[[lng,lat], ...]]"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
